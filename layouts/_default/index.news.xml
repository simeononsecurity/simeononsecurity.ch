

{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
    {{/* Google News only wants recently-published news/article-style content,
         not tool pages, listings, or reference pages like /hof/ or /recommendations/.
         Restrict to the sections that actually publish dated articles. */}}
    {{ $newsSections := slice "articles" "writeups" "blog" "til" "guides" }}
    {{ range .Site.RegularPages }}
    {{ if in $newsSections .Section }}
    {{/* Use .Date (the original publish date from front matter) for both the
         48-hour recency filter and news:publication_date. Google requires the
         original publish date here, not a modification date, and .Date is not
         subject to the Git-derived Lastmod inaccuracy that shallow CI checkouts
         can introduce. See .clinerules note on enableGitInfo + fetch-depth. */}}
    {{ if lt (div (sub now.Unix .Date.Unix) 3600) 48 }}
        <url>
            <loc>{{ .Permalink }}</loc>
            <news:news>
                <news:publication>
                    <news:name>{{ or ($.Site.Params.Author.Name) ($.Site.Title) }}</news:name>
                    <news:language>{{ $.Language.Lang }}</news:language>
                </news:publication>
                {{ if not .Date.IsZero }}
                <news:publication_date>{{ safeHTML ( .Date.Format "2006-01-02T15:04:05-07:00" ) }}</news:publication_date>
                {{ end }}
                <news:title>{{ .Title }}</news:title>
            </news:news>
        </url>
    {{ end }}
    {{ end }}
    {{ end }}
</urlset>

