# Generated files by hugo
/public/
/assets/jsconfig.json

# Hugo generated resources and build cache. Regenerated on demand by any local
# build, and restored in CI from actions/cache (see
# .github/workflows/branch_build_hugo_*.yml), never from git. Each workflow also
# deletes resources/ before pushing the built output to its website-<lang>
# branch, so nothing here ever reaches a deploy branch.
resources/_gen/
resources/json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# Build and Release Folders
bin/
bin-debug/
bin-release/
[Oo]bj/ # FlashDevelop obj
[Bb]in/ # FlashDevelop bin

# Python virtual environment
.venv/
venv/
__pycache__/
*.pyc

# PlatformIO MCP server workspace (audit logs, command history, local state)
.pio-mcp-workspace/

# Other files and folders
/reports/
.settings/
.DS_Store
dist
tmp
.vs
debug.log
.env
.env.google
.docx
.doc
.pdf

# Executables
*.swf
*.air
*.ipa
*.apk
clean-legacy-translations.ps1
tools/pngcrush_1_8_11_w64.exe
tools/optimize-images.py
tools/pngcrush.exe
*.img
tools/fix_content.py
tools/generate_ad_images.py
